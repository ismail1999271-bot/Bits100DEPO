# Licensed BIST real-time / Level 2 provider endpoint.
# Use the provider's documented API gateway; do not put credentials in git.
BIST_MARKET_DATA_URL=
BIST_MARKET_DATA_URL_TOKEN=

# KAP REST API subscription endpoint.
KAP_API_URL=
KAP_API_URL_TOKEN=

# Licensed news feed endpoint.
NEWS_API_URL=
NEWS_API_URL_TOKEN=

# TEFAS/fund-flow or licensed fund-data endpoint.
FUND_FLOW_API_URL=
FUND_FLOW_API_URL_TOKEN=

# Broker research / consensus feed endpoint.
BROKER_DATA_URL=
BROKER_DATA_URL_TOKEN=

# Institutional holdings / transactions / research endpoint.
INSTITUTIONAL_DATA_URL=
INSTITUTIONAL_DATA_URL_TOKEN=

# The live pipeline remains fail-closed unless these feeds are populated.
LIVE_DATA_MODE=fail_closed
NO_SYNTHETIC_LIVE_DATA=true
